{
  "name": "code-dungeon",
  "version": "0.1.0",
  "description": "Un gioco cozy in pixel art che spiega il codice generato dagli LLM. Il gioco è un server MCP: qualsiasi agente lo pilota.",
  "type": "module",
  "private": true,
  "bin": {
    "code-dungeon": "./dist/server/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && npm run build:game",
    "build:server": "tsc -p tsconfig.server.json",
    "build:game": "vite build",
    "build:demo": "vite build --mode demo",
    "mcp": "tsx src/server/cli.ts mcp",
    "play": "tsx src/server/cli.ts play",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.game.json --noEmit",
    "test:mcp": "tsx scripts/test-mcp.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
