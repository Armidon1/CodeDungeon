{
  "name": "code-dungeon",
  "version": "0.1.0",
  "private": true,
  "description": "Un gioco cozy in pixel art che spiega il codice generato dagli LLM. Il gioco è un server MCP: qualsiasi agente lo pilota.",
  "license": "MIT",
  "author": "Armidon1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Armidon1/CodeDungeon.git"
  },
  "homepage": "https://github.com/Armidon1/CodeDungeon#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "gemini-cli",
    "code-tour",
    "pixel-art",
    "education"
  ],
  "type": "module",
  "bin": {
    "code-dungeon": "./dist/server/cli.js"
  },
  "files": [
    "dist/server",
    "dist/shared",
    "dist/game"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server && npm run build:game",
    "build:server": "tsc -p tsconfig.server.json",
    "build:game": "vite build",
    "build:demo": "vite build --mode demo",
    "mcp": "tsx src/server/cli.ts mcp",
    "play": "tsx src/server/cli.ts play",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.game.json --noEmit",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tauri-apps/api": "^2.12.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
